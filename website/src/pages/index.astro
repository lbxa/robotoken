---
import { getCollection, render } from "astro:content";
import Highlight from "../components/Highlight.astro";
import "katex/dist/katex.min.css";
import "../styles/global.css";

const title = "What Would a GPT-3-Scale Robotics Dataset Cost?";
const reportType = "Robotoken research preprint";
const reportDate = "September 29, 2026";
const description = "Robotoken estimates the cost of a five-year robotics data collection program: $219 per retained robot-hour in the base case. A study of data scales, acquisition costs, and the limits of token comparisons.";
const canonical = new URL("/", Astro.site);
const entries = await getCollection("sections");
const abstract = entries.find((entry) => entry.data.slug === "abstract");
if (!abstract) throw new Error("The report needs an abstract.");
const { Content: Abstract } = await render(abstract);
const sections = await Promise.all(
  entries.filter((entry) => entry !== abstract)
    .sort((a, b) => a.data.order - b.data.order)
    .map(async (entry) => ({
      id: entry.data.slug!,
      title: entry.data.title,
      Content: (await render(entry)).Content,
    })),
);
const artifacts = [
  { label: "Read the PDF", href: "/files/robotoken.pdf" },
  { label: "BibTeX", href: "#citation" },
];
---

<html lang="en" class="bg-stone-50">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="author" content="Lucas Barbosa" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="Robotoken" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <title>Robotoken — {title}</title>
  </head>
  <body class="bg-stone-50 text-stone-950">
    <a href="#abstract" class="skip-link">Skip to the report</a>
    <main class="min-h-screen bg-stone-50">
      <section class="mb-12 pt-8 md:pt-12">
        <div class="mx-auto max-w-3xl px-1">
          <header class="mb-12 pt-20">
            <div class="mb-14 space-y-2 text-center text-xs">
              <svg
                viewBox="0 0 22 12"
                aria-hidden="true"
                class="mx-auto mb-4 block h-3 w-auto text-sm leading-none text-stone-800"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path
                  d="M6 1.5C3.51 1.5 1.5 3.51 1.5 6C1.5 8.49 3.51 10.5 6 10.5C8.2 10.5 9.98 8.95 11 7C12.02 8.95 13.8 10.5 16 10.5C18.49 10.5 20.5 8.49 20.5 6C20.5 3.51 18.49 1.5 16 1.5C13.8 1.5 12.02 3.05 11 5C9.98 3.05 8.2 1.5 6 1.5Z"
                  stroke="currentColor"
                  stroke-width="1.2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
              <p class="uppercase">{reportType}</p>
              <p><time datetime="2026-09-29">{reportDate}</time></p>
            </div>

            <hr class="mb-0 w-full border-t-4 border-stone-950" />
            <h1 class="py-10 text-center text-4xl font-light tracking-tight [text-wrap:balance]">{title}</h1>
            <hr class="w-full border-t-2 border-stone-950" />
            <div class="mt-12 flex flex-wrap items-start justify-center gap-x-5 gap-y-4 text-center text-sm text-stone-600 md:mt-14">
              <span class="inline-flex flex-col items-center">
                <span class="font-medium text-stone-900 underline underline-offset-4">Lucas Barbosa</span>
                <span>NYU</span>
              </span>
            </div>

            <div class="mt-10 flex flex-wrap items-center justify-center gap-3">
              {artifacts.map(({ label, href }) => (
                <a href={href}
                  target={href.endsWith(".pdf") ? "_blank" : undefined}
                  rel={href.endsWith(".pdf") ? "noopener noreferrer" : undefined}
                  class="inline-flex items-center justify-center rounded-full border border-stone-300 bg-white px-4 py-2 text-center text-xs font-medium text-stone-800 transition-colors hover:border-stone-950 hover:bg-stone-950 hover:text-white">
                  {label}
                </a>
              ))}
            </div>
          </header>
        </div>
      </section>

      <section class="pb-20">
        <div class="mx-auto max-w-3xl px-3 md:px-1">
          <div class="flex flex-col space-y-12">
            <section id="abstract" aria-label="Abstract">
              <div class="prose prose-stone mx-auto max-w-2xl text-center text-sm leading-relaxed">
                <Abstract components={{ Highlight }} />
              </div>
            </section>
            <nav class="mb-8 mt-4" aria-label="Table of Contents">
              <p class="mb-3 text-xs font-medium tracking-wide text-stone-500">&mdash; Table of Contents</p>
              <ul class="flex flex-col gap-1 pl-4">
                {sections.map(({ id, title }) => (
                  <li>
                    <a href={`#${id}`} class="inline-block text-sm text-stone-500 transition-colors hover:text-stone-700 focus-visible:text-stone-800 focus-visible:underline focus-visible:outline-none">{title}</a>
                  </li>
                ))}
              </ul>
            </nav>
            {sections.map(({ id, title, Content }) => (
              <section id={id}>
                <h2 class="mb-4 text-4xl tracking-wide text-stone-900">{title}</h2>
                <div class="prose prose-stone max-w-none"><Content components={{ Highlight }} /></div>
              </section>
            ))}
          </div>
        </div>
      </section>

      <footer class="border-t border-stone-200 py-8">
        <div class="mx-auto flex max-w-3xl items-center justify-center gap-6 px-3 md:gap-8">
          <a href="https://robotoken.lbxa.net" class="text-sm text-stone-600">Robotoken</a>
        </div>
      </footer>
    </main>
  </body>
</html>
