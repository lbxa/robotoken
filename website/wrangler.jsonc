{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "robotoken",
  "compatibility_date": "2026-09-29",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "robotoken.lbxa.net",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
